# ═══════════════════════════════════════════════════════════════
#  Stella — Configuração de LLM
# ═══════════════════════════════════════════════════════════════

# ─── MODO DE OPERAÇÃO ──────────────────────────────────────────
#
#   auto   → tenta remoto primeiro; se falhar usa local (padrão)
#   remoto → somente HF Inference Providers (gasta créditos)
#   local  → somente modelo local (sem internet, sem créditos)
#
LLM_MODE=auto

# ─── MODELO REMOTO (HF Inference Providers) ───────────────────
#  Token: https://huggingface.co/settings/tokens
#  Créditos: https://huggingface.co/settings/billing
#
HF_TOKEN=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

#  Modelo remoto — qualquer um de:
#  https://huggingface.co/models?pipeline_tag=text-generation
STELLA_REMOTE_MODEL=Qwen/Qwen2.5-7B-Instruct


# ─── MODELO LOCAL ─────────────────────────────────────────────
#  Baixado uma vez e salvo em cache. Rode offline depois.
#
#  Escolha conforme hardware:
#    Qwen/Qwen2.5-1.5B-Instruct  → ~2 GB RAM  (PC fraco)
#    Qwen/Qwen2.5-3B-Instruct    → ~5 GB RAM  (CPU)
#    Qwen/Qwen2.5-7B-Instruct    → ~9 GB VRAM (GPU RTX 4060 ✓)
#
STELLA_LOCAL_MODEL=Qwen/Qwen2.5-7B-Instruct


# ─── Outros ───────────────────────────────────────────────────
LLM_TIMEOUT=120
